# Copy to your environment / process manager. Never commit real secrets.
NACB_SECRET_KEY=change-me-to-a-long-random-string
NACB_DEBUG=false
NACB_ALLOWED_HOSTS=nacb.org.bw,www.nacb.org.bw
NACB_CSRF_TRUSTED_ORIGINS=https://nacb.org.bw,https://www.nacb.org.bw
NACB_SITE_URL=https://nacb.org.bw

NACB_DB_ENGINE=postgresql
NACB_DB_NAME=nacb
NACB_DB_USER=nacb
NACB_DB_PASSWORD=
NACB_DB_HOST=localhost

NACB_PRIVATE_MEDIA_ROOT=/srv/nacb/private_media
NACB_MAX_UPLOAD_MB=10
NACB_REQUIRE_STAFF_MFA=true

NACB_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
NACB_EMAIL_HOST=smtp.example.com
NACB_EMAIL_PORT=587
NACB_EMAIL_USER=
NACB_EMAIL_PASSWORD=
NACB_FROM_EMAIL=NACB Digital Services <no-reply@nacb.org.bw>

# SMS: "console" logs only; "http" POSTs JSON {to, from, message} to NACB_SMS_URL
NACB_SMS_BACKEND=console
NACB_SMS_URL=
NACB_SMS_API_KEY=
NACB_SMS_SENDER=NACB

# Footer credit link (developer website)
NACB_DEVELOPER_URL=https://www.cyberjayainvest.com/
